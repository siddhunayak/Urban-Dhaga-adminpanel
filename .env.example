# Database connection string (SQLite for local, PostgreSQL/Supabase for production)
DATABASE_URL="file:./dev.db"

# Generate a strong 32+ char secret for signing HTTP-only session cookies in production
AUTH_SECRET="replace-with-a-strong-random-32-char-secret"

# Optional shared secret for external website/WhatsApp lead ingestion (x-webhook-secret header on POST /api/leads)
LEAD_WEBHOOK_SECRET="replace-with-a-webhook-secret"
